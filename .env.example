# All variables are prefixed with SAMARTHX_MAIN_ so this project can share a
# server with other apps without environment-variable collisions.
#
# Browser-exposed variables must keep the NEXT_PUBLIC_ prefix first
# (e.g. NEXT_PUBLIC_SAMARTHX_MAIN_*) — Next.js only inlines vars that
# literally start with NEXT_PUBLIC_.

# ── Required ──
# PostgreSQL connection string (URL-encode special characters in the password)
SAMARTHX_MAIN_CMS_DATABASE_URL=postgresql://user:password@localhost:5432/your-database

# Payload CMS secret — use a long random value
SAMARTHX_MAIN_PAYLOAD_SECRET=YOUR_SECRET_HERE

# Signing key for applicant session tokens — use a long random value.
# Required: the app throws if this is missing (no insecure fallback).
SAMARTHX_MAIN_JWT_SECRET=YOUR_JWT_SECRET_HERE

# ── Server ──
# Port the app listens on (used by `pnpm dev` and `pnpm start`)
SAMARTHX_MAIN_PORT=3699

# Public base URL of the site, used to build absolute links (e.g. resume URLs)
NEXT_PUBLIC_SAMARTHX_MAIN_APP_URL=http://localhost:3699

# ── Uploads (paths relative to the project root) ──
SAMARTHX_MAIN_CMS_RESUMES_UPLOAD_DIR=resumes
SAMARTHX_MAIN_CMS_DOCUMENTS_UPLOAD_DIR=documents

# ── Superset analytics (optional — only for the Analytics Dashboard block) ──
NEXT_PUBLIC_SAMARTHX_MAIN_SUPERSET_URL=
SAMARTHX_MAIN_SUPERSET_BASE_URL=
SAMARTHX_MAIN_SUPERSET_USERNAME=
SAMARTHX_MAIN_SUPERSET_PASSWORD=
SAMARTHX_MAIN_SUPERSET_PROVIDER=db

# ── SMTP (optional — needed for applicant OTP signup and password reset) ──
SAMARTHX_MAIN_SMTP_HOST=
SAMARTHX_MAIN_SMTP_PORT=587
SAMARTHX_MAIN_SMTP_USERNAME=
SAMARTHX_MAIN_SMTP_PASSWORD=
SAMARTHX_MAIN_SMTP_SENDER_EMAIL=
