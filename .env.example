# ── Required ──
# PostgreSQL connection string (URL-encode special characters in the password)
CMS_DATABASE_URL=postgresql://user:password@localhost:5432/your-database

# Payload CMS secret — use a long random value
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Signing key for applicant session tokens — use a long random value.
# Required: the app throws if this is missing (no insecure fallback).
JWT_SECRET=YOUR_JWT_SECRET_HERE

# ── Server ──
# Port the app listens on (used by `pnpm dev` and `pnpm start`)
PORT=3699

# Public base URL of the site, used to build absolute links (e.g. resume URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3699

# ── Uploads ──
# Directory (relative to project root) where uploaded resumes are stored
CMS_RESUMES_UPLOAD_DIR=resumes

# ── Superset analytics (optional — only for the Analytics Dashboard block) ──
NEXT_PUBLIC_SUPERSET_URL=
SUPERSET_BASE_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_PROVIDER=db

# ── SMTP (optional — needed for applicant OTP signup and password reset) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
